<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="entidades" nsURI="http://www.example.org/entidades" nsPrefix="ent">

  <!-- Entidade (será uma tabela no SQL) -->
  <eClassifiers xsi:type="ecore:EClass" name="Entidade">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nome"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="atributos" upperBound="-1"
        eType="#//Atributo" containment="true"/>
  </eClassifiers>

  <!-- Atributo (será uma coluna no SQL) -->
  <eClassifiers xsi:type="ecore:EClass" name="Atributo">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nome"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tipo"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ehChavePrimaria"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Relacionamento (será uma chave estrangeira no SQL) -->
  <eClassifiers xsi:type="ecore:EClass" name="Relacionamento">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nome"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="origem"
        eType="#//Entidade" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="destino"
        eType="#//Entidade" containment="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="multiplicidadeOrigem"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="multiplicidadeDestino"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Modelo (classe raiz) -->
  <eClassifiers xsi:type="ecore:EClass" name="ModeloEntidade">
    <eStructuralFeatures xsi:type="ecore:EReference" name="entidades" upperBound="-1"
        eType="#//Entidade" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relacionamentos" upperBound="-1"
        eType="#//Relacionamento" containment="true"/>
  </eClassifiers>

</ecore:EPackage>